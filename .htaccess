<IfModule mod_rewrite.c>
    Options +FollowSymLinks
    RewriteEngine On

    # XAMPP subdirectory only — set RewriteBase if the app is not at the domain root.
    # Example for http://localhost/quickprints/ :
    # RewriteBase /quickprints/

    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
